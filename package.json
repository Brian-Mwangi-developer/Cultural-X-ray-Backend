{
  "name": "xray-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cultural X-Ray API, auth and background workers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "prisma generate && tsup",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "stack": "bash scripts/stack.sh",
    "env:init": "bash scripts/init-env.sh",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ses:verify": "tsx src/scripts/ses-verify.ts",
    "lookup:smoke": "tsx src/scripts/lookup-smoke.ts",
    "map:smoke": "tsx src/scripts/map-smoke.ts"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1152.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "amqplib": "^2.2.0",
    "better-auth": "1.7.11",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
