# Copy to .env, or run: pnpm env:init
NODE_ENV="development"
LOG_LEVEL="info"
PORT="4000"
WORKER_METRICS_PORT="4001"
PUBLIC_WEB_URL="http://localhost:3000"
WEB_ORIGINS="http://localhost:3000"
DATABASE_URL=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
REDIS_HOST="localhost"
REDIS_PORT="6390"
REDIS_PASSWORD=""
REDIS_DB="0"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5682"
RABBITMQ_USERNAME="xray"
RABBITMQ_PASSWORD=""
RABBITMQ_VHOST="xray"
METRICS_TOKEN=""
OPS_TOKEN=""
GRAFANA_ADMIN_PASSWORD=""
EMAIL_PROVIDER="log"
EMAIL_FROM=""
EMAIL_REPLY_TO=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Ad check: uploads (Vercel Blob) and Gemini on Vertex AI. See README.md "Gemini on Vertex AI: pricing".
BLOB_READ_WRITE_TOKEN=""
BLOB_ACCESS="private"
ADCHECK_MAX_SECONDS="60"
ADCHECK_MAX_BYTES="1000000000"
ADCHECK_KEEP_DAYS="14"
GEMINI_PROVIDER="practice"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
# An API key bound to a service account with only "Vertex AI User", restricted to aiplatform.googleapis.com.
# Plain (unbound) API keys are rejected by Vertex. Empty: Google application default credentials.
GOOGLE_VERTEX_API_KEY=""
GEMINI_MODEL_FAST="gemini-3.5-flash-lite"
GEMINI_MODEL_SMART="gemini-3.8-flash"
